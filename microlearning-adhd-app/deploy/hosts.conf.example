# Host and port configuration for per-condition deployment (e.g. NVIDIA DGX Spark).
#
# Copy to hosts.conf and edit:
#   cp deploy/hosts.conf.example deploy/hosts.conf
#
# Architecture (firewall-friendly):
#   Participant browser → FRONTEND_PORT (nginx, public)
#   nginx /api/*        → 127.0.0.1:BACKEND_PORT (uvicorn, loopback only)
#
# Open only FRONTEND_PORT in your firewall. Backend ports stay internal to the Spark.
#
# BIND host: 0.0.0.0 listens on all interfaces (typical on a Spark).
# PUBLIC host: address participants use in the browser (shown in startup logs).
#   - Set SPARK_PUBLIC_IP to one IP shared by all conditions, or
#   - Set CONDITION_<X>_PUBLIC_HOST per condition when each arm uses a different IP.

# Optional default public IP/hostname for participant URLs and CORS (overridden per condition).
# SPARK_PUBLIC_IP=10.0.0.42

# --- Condition A (Control: Standard Text) ---
CONDITION_A_BIND_HOST=0.0.0.0
CONDITION_A_FRONTEND_PORT=5173
CONDITION_A_BACKEND_PORT=8000
# CONDITION_A_PUBLIC_HOST=10.0.0.42

# --- Condition B (Status Quo: AI Summary) ---
CONDITION_B_BIND_HOST=0.0.0.0
CONDITION_B_FRONTEND_PORT=5174
CONDITION_B_BACKEND_PORT=8001
# CONDITION_B_PUBLIC_HOST=10.0.0.42

# --- Condition C (Experimental: Socratic Unlock) ---
CONDITION_C_BIND_HOST=0.0.0.0
CONDITION_C_FRONTEND_PORT=5175
CONDITION_C_BACKEND_PORT=8002
# CONDITION_C_PUBLIC_HOST=10.0.0.42
